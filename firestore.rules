rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------- Shared Primitives ----------
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ---------- Entity Validation Blueprints ----------
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'wardName', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'wardName', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.wardName is string && data.wardName.size() >= 1 && data.wardName.size() <= 60
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPatientProfile(data) {
      return data.keys().hasAll([
          'ownerId', 'babyName', 'bedNumber', 'ageDays', 'weightKg',
          'feedingIntervalHours', 'diaperIntervalHours', 'medicalNotes',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'babyName', 'bedNumber', 'ageDays', 'weightKg',
          'feedingIntervalHours', 'diaperIntervalHours', 'medicalNotes',
          'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.babyName is string && data.babyName.size() >= 1 && data.babyName.size() <= 80
        && data.bedNumber is string && data.bedNumber.size() >= 1 && data.bedNumber.size() <= 24
        && data.ageDays is number && data.ageDays >= 0 && data.ageDays <= 365
        && data.weightKg is number && data.weightKg >= 0.4 && data.weightKg <= 12
        && data.feedingIntervalHours is number && data.feedingIntervalHours >= 1 && data.feedingIntervalHours <= 8
        && data.diaperIntervalHours is number && data.diaperIntervalHours >= 1 && data.diaperIntervalHours <= 12
        && data.medicalNotes is string && data.medicalNotes.size() <= 500
        && data.status in ['active', 'discharged']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // ---------- User Profiles (Strict Owner-Only PII Isolation) ----------
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidUserProfile(incoming())
        && isValidId(userId)
        && isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'wardName', 'updatedAt']);
      allow delete: if false;
    }

    // ---------- Patient Profiles ----------
    match /patients/{patientId} {
      allow get: if isValidId(patientId)
        && isSignedIn()
        && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(patientId)
        && isSignedIn()
        && isValidPatientProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isSignedIn()
        && isValidPatientProfile(incoming())
        && isValidId(patientId)
        && existing().ownerId == request.auth.uid
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (existing().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'babyName', 'bedNumber', 'ageDays', 'weightKg',
              'feedingIntervalHours', 'diaperIntervalHours', 'medicalNotes',
              'status', 'updatedAt'
            ]))
          || (existing().status == 'discharged'
            && incoming().status == 'active'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'bedNumber', 'updatedAt']))
        );
      allow delete: if isValidId(patientId)
        && isSignedIn()
        && existing().ownerId == request.auth.uid;
    }
  }
}
